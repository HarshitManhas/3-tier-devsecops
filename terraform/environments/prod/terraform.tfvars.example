# DevOps Project — Terraform Variables
# Copy to terraform.tfvars and fill in your values
# NEVER commit terraform.tfvars (it's in .gitignore)

aws_region   = "ap-south-1"
project_name = "devops-project"
environment  = "prod"

# RDS MySQL
rds_db_name  = "crud_app"
rds_username = "CHANGE_ME"              # e.g. appuser
rds_password = "CHANGE_ME_STRONG_PASSWORD"  # min 8 chars

# EC2 instances
jenkins_instance_type   = "t3.large"    # Jenkins: 2 vCPU, 8GB RAM
sonarqube_instance_type = "t3.medium"   # SonarQube: 2 vCPU, 4GB RAM

# SSH key pair name (create in AWS Console > EC2 > Key Pairs)
jenkins_key_name = "your-key-pair-name"

# Your public IP — google "what is my ip" and add /32
your_ip_cidr = "YOUR_PUBLIC_IP/32"

# Your domain name
domain_name = "yourdomain.com"
