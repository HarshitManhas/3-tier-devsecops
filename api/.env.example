# Database Configuration
DB_HOST=mysql
DB_USER=appuser
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=crud_app
DB_PORT=3306

# Application
PORT=5000
NODE_ENV=development

# JWT - Use a strong random secret (min 32 chars)
JWT_SECRET=CHANGE_ME_USE_openssl_rand_-hex_32
JWT_EXPIRES_IN=24h

# For production: fetch from AWS Secrets Manager
# AWS_SECRET_NAME=prod/3tier-app/api
# AWS_REGION=ap-south-1
